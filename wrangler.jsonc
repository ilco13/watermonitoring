{
  "name": "eau",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "build": { "command": "node scripts/build-assets.mjs", "watch_dir": "public" },
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "ASL_URL": "https://asl.pierrotcolombine.workers.dev", "ASL_NAME": "Pierrot et Colombine", "SITE_URL": "https://eau.pierrotcolombine.workers.dev" },
  "services": [{ "binding": "ASL", "service": "asl" }],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "eau-sauvegardes" }],
  "triggers": { "crons": ["17 3 * * 1", "10 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eau",
      "database_id": "b8c3671b-f65a-47ae-8ce3-f6eb368ecab2",
      "migrations_dir": "migrations"
    }
  ]
}
