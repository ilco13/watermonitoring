{
  "name": "eau",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eau",
      "database_id": "REMPLACER-PAR-LID-AFFICHE-PAR-wrangler-d1-create",
      "migrations_dir": "migrations"
    }
  ]
}
